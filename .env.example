# =============================================================================
# OpenAD — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# =============================================================================

# Active Directory server address (hostname or IP)
LDAP_SERVER=

# LDAP port — 389 for plain LDAP or StartTLS, 636 for LDAPS
LDAP_PORT=389

# AD domain name (e.g. company.local or company.com)
LDAP_DOMAIN=

# Base DN for user searches (e.g. dc=company,dc=local)
LDAP_BASE_DN=

# Transport security
# LDAP_USE_SSL=true  → LDAPS on port 636 (implicit TLS)
# LDAP_USE_TLS=true  → StartTLS on port 389 (explicit upgrade)
# Both false         → plain LDAP (internal/dev environments only)
LDAP_USE_SSL=false
LDAP_USE_TLS=false

# Path to CA certificate file inside the container (for self-signed or internal CA)
# Uncomment and set if LDAP_USE_SSL or LDAP_USE_TLS is true
# CA_CERT_PATH=/certs/ca.crt

# Service account for read-only DN lookup
# Use UPN format: account@domain or DOMAIN\account
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# Rate limiting
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=300

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
