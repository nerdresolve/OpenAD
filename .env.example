# =============================================================================
# OpenAD — modelo de configuração
# =============================================================================
# Copie para `.env` e preencha com os valores do seu ambiente.
# O `.env` NUNCA entra no Git: ele carrega a senha da conta de serviço.
#
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Active Directory
# -----------------------------------------------------------------------------

# Endereço do Domain Controller (hostname ou IP).
# Prefira o hostname: com StartTLS, o certificado é validado contra o nome.
LDAP_SERVER=

# 389 para LDAP puro ou StartTLS. 636 para LDAPS.
LDAP_PORT=389

# Domínio AD. Ex.: empresa.local ou empresa.com.br
LDAP_DOMAIN=

# Base DN das buscas. Ex.: dc=empresa,dc=local
LDAP_BASE_DN=

# StartTLS na porta 389. Deixe `true` sempre que o tráfego até o DC sair do
# segmento de rede do container — a troca de senha exige canal cifrado.
LDAP_USE_TLS=false

# Certificado da CA interna, dentro do container. Sem ele o TLS sobe sem
# validar o par, o que só é aceitável em laboratório.
# CA_CERT_PATH=/certs/ca.crt

# Conta de serviço. Precisa de leitura no diretório e de "Redefinir senha"
# delegado na OU dos usuários. Formato UPN: conta@dominio
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# -----------------------------------------------------------------------------
# Proteção contra força bruta
# -----------------------------------------------------------------------------

# Tentativas por IP dentro da janela, e a janela em segundos.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=300

# DEBUG, INFO, WARNING, ERROR. DEBUG expõe a estrutura do diretório nos logs:
# use para diagnóstico, não deixe ligado.
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Marca
# -----------------------------------------------------------------------------
# O portal é a cara de quem opera, não a de quem escreveu o código. Estas
# variáveis repintam a tela sem tocar em HTML nem reconstruir a imagem.

# Nome exibido no topo e na aba do navegador.
BRAND_NAME=OpenAD

# Logo. Aponte para um arquivo seu servido em /static, ou para uma URL externa.
BRAND_LOGO_URL=/static/brand-mark.svg

# Cor principal e cor de acento, em hexadecimal.
BRAND_COLOR=#7C3AED
BRAND_COLOR_ACCENT=#A855F7

# Texto do rodapé. Vazio usa BRAND_NAME.
BRAND_FOOTER=

# UPN de exemplo no campo de usuário. Use o seu domínio: sem isso a pessoa
# fica adivinhando o formato esperado.
BRAND_UPN_EXAMPLE=usuario@empresa.local
